{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Update the example function's build and runtime images in one PR",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["example/Dockerfile"],
      "groupName": "example function images"
    },
    {
      "description": "Automerge non-major updates, digest pins and lock file maintenance once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "A proto update needs the file re-downloaded and the code regenerated by hand",
      "matchPackageNames": ["crossplane/crossplane"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the crossplane/crossplane release the vendored run_function.proto was copied from",
      "managerFilePatterns": ["/^sdk/proto/v1/run_function\\.proto$/"],
      "matchStrings": [
        "Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\."
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crossplane/crossplane"
    }
  ]
}
